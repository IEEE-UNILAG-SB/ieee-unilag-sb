NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Auth (server-only — never prefix these with NEXT_PUBLIC_)
# Generate with: npx auth secret  (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/ieee-unilag-sb

# Google OAuth (leave blank until the branch creates the OAuth client;
# the Google button stays visibly disabled until these exist)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Client-side feature flag for the Google button (safe to expose)
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
